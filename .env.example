# ==============================================================================
# BuildLink Environment Configuration
# ==============================================================================

# Node Environment
NODE_ENV=development

# ------------------------------------------------------------------------------
# Backend API (apps/api)
# ------------------------------------------------------------------------------
PORT=5000
API_PREFIX=/api/v1
CORS_ORIGIN=http://localhost:3000

# Microsoft SQL Server 2025 Express Database Configuration
DB_HOST=localhost
DB_PORT=1433
DB_USER=sa
DB_PASSWORD=YourStrongPassword123!
DB_NAME=BuildLinkDB
DB_ENCRYPT=false
DB_TRUST_SERVER_CERTIFICATE=true

# Authentication Secrets
JWT_SECRET=your_jwt_super_secret_key_change_in_production_min_32_chars
JWT_EXPIRES_IN=7d
REFRESH_TOKEN_SECRET=your_refresh_token_super_secret_key_change_in_production
REFRESH_TOKEN_EXPIRES_IN=30d

# File Storage (local | s3)
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./uploads
MAX_FILE_SIZE_MB=10

# ------------------------------------------------------------------------------
# Frontend Web (apps/web)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_NAME=BuildLink
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:5000/api/v1
